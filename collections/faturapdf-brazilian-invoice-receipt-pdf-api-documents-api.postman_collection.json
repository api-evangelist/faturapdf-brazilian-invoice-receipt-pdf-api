          "name": "Gera um PDF de fatura ou recibo",
          "request": {
            "name": "Gera um PDF de fatura ou recibo",
            "description": {
              "content": "Recebe emitente, destinatário, itens e metadados via JSON e devolve os bytes do PDF pronto. `tipo` controla o layout: \"fatura\" (default, cabeçalho + tabela + total em destaque) ou \"recibo\" (parágrafo narrativo \"Recebemos de...\" + linha de assinatura). Totais (`subtotalItem`, `subtotal`, `total`) são calculados pela API — não são enviados pelo cliente.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "invoice"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emitente\": {\n    \"nome\": \"<string>\",\n    \"documento\": \"<string>\",\n    \"endereco\": \"<string>\",\n    \"email\": \"<string>\",\n    \"telefone\": \"<string>\"\n  },\n  \"destinatario\": {\n    \"nome\": \"<string>\",\n    \"documento\": \"<string>\",\n    \"endereco\": \"<string>\",\n    \"email\": \"<string>\",\n    \"telefone\": \"<string>\"\n  },\n  \"itens\": [\n    {\n      \"descricao\": \"<string>\",\n      \"valor_unitario\": \"<number>\",\n      \"quantidade\": 1\n    }\n  ],\n  \"tipo\": \"fatura\",\n  \"numero\": \"<string>\",\n  \"data\": \"<string>\",\n  \"vencimento\": \"<string>\",\n  \"desconto\": 0,\n  \"forma_pagamento\": \"<string>\",\n  \"observacoes\": \"<string>\",\n  \"pix_copia_cola\": \"<string>\",\n  \"mostrar_valor_por_extenso\": false\n}",
